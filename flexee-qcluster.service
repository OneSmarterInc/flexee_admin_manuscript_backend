[Unit]
Description=Flexee Django-Q Worker
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/flexee/flexee_admin_manuscript_backend
EnvironmentFile=/var/www/flexee/flexee_admin_manuscript_backend/.env
ExecStart=/var/www/flexee/flexee_admin_manuscript_backend/.venv/bin/python manage.py qcluster
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
