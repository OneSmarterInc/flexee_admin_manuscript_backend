[Unit]
Description=Flexee Queue Health Monitor
After=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/flexee/flexee_admin_manuscript_backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/flexee/flexee_admin_manuscript_backend/.venv/bin/python manage.py check_queue_health --alert --fail-on-unhealthy
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
