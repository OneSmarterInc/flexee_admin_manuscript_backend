# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-this-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
MAX_MANUSCRIPT_BYTES=20971520
MAX_SUBMISSION_ITEM_BYTES=10485760
# Aggregate upload ceilings. These include active manuscript files and venue requirement files.
AUTHOR_STORAGE_LIMIT_BYTES=104857600
TOTAL_STORAGE_LIMIT_BYTES=10737418240
REVIEW_JOB_QUEUE_TIMEOUT_MINUTES=10
REVIEW_JOB_PROCESSING_TIMEOUT_MINUTES=30
RETENTION_SWEEP_BATCH_SIZE=200
AUTHOR_VERIFY_RESEND_WINDOW_MINUTES=15
AUTHOR_VERIFY_RESEND_MAX=3

# Production transport and private upload storage
# DJANGO_ENV=production requires explicit HTTPS frontend origins/allowed hosts
# and PRIVATE_MEDIA_ROOT outside the application source tree.
PRIVATE_MEDIA_ROOT=
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Enable only when a trusted reverse proxy sets X-Forwarded-Proto correctly.
TRUST_X_FORWARDED_PROTO=false
# List exact trusted reverse-proxy IPs. '*' is rejected in production.
TRUSTED_PROXIES=

# Hardened manuscript ZIP limits
MANUSCRIPT_ZIP_MAX_FILES=40
MANUSCRIPT_ZIP_MAX_UNCOMPRESSED_BYTES=52428800
MANUSCRIPT_ZIP_MAX_COMPRESSION_RATIO=200

# Local development review model (Ollama).
# For production, explicitly choose AI_PROVIDER=anthropic or an approved on-prem model.
# Do not use qwen2.5:0.5b-instruct as the production editorial-judgment model.
# Install Ollama separately, then run: ollama pull qwen2.5:0.5b-instruct
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b-instruct
# Lightweight defaults for an 8 GB RAM development machine.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2000
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=300
# Keep ZIP chapter inference low-contention on 8 GB RAM machines.
OLLAMA_CHAPTER_WORKERS=2
# Anthropic cloud provider. Required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Set true only for local smoke testing when you do not want a live model call.
MOCK_AI_REVIEW=false

# SMTP. When SMTP_HOST is blank, Django prints email to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
NOTIFY_FROM_EMAIL=editor@flexee.org
EDITOR_EMAIL=editor@flexee.org
DEFAULT_REVIEW_EMAIL=

# Admin/editor accounts are database-backed.
# Create a platform admin after migrations with:
# python manage.py create_editor_user admin@example.com --platform_superuser
# Keep legacy ADMIN_* values blank unless you intentionally support a legacy path.

ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_MAX_FAILURES=10

# Production backup/restore
# In production, point BACKUP_ROOT at a protected durable volume outside MEDIA_ROOT.
BACKUP_ROOT=
BACKUP_RETENTION_DAYS=30
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
# Restore never falls back to DATABASE_URL. Supply a dedicated target explicitly.
RESTORE_TARGET_DATABASE_URL=
RELEASE_SHA=

# Production error monitoring (Sentry)
# Leave SENTRY_DSN blank to disable all outbound monitoring.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Set to the deployed git commit/release identifier. Falls back to RELEASE_SHA.
SENTRY_RELEASE=
# Error events are enabled when SENTRY_DSN is set. Performance tracing stays off by default.
SENTRY_TRACES_SAMPLE_RATE=0

# Queue health monitoring / alert thresholds
# Defaults warn before the existing 10-minute queued and 30-minute processing sweep timeouts.
QUEUE_HEALTH_WARNING_QUEUED_JOBS=10
QUEUE_HEALTH_CRITICAL_QUEUED_JOBS=25
QUEUE_HEALTH_WARNING_OLDEST_QUEUED_SECONDS=300
QUEUE_HEALTH_CRITICAL_OLDEST_QUEUED_SECONDS=600
QUEUE_HEALTH_WARNING_OLDEST_PROCESSING_SECONDS=1350
QUEUE_HEALTH_CRITICAL_OLDEST_PROCESSING_SECONDS=1800
QUEUE_HEALTH_FAILURE_WINDOW_MINUTES=60
QUEUE_HEALTH_WARNING_RECENT_FAILURES=3
QUEUE_HEALTH_CRITICAL_RECENT_FAILURES=10
QUEUE_HEALTH_ALERT_COOLDOWN_MINUTES=30

# AI usage/cost tracking and cloud spending ceilings
# Local Ollama calls are tracked at zero provider cost unless you explicitly price them.
# For cloud use, set enforcement=true, choose your own budgets, and enter the
# current provider/model rates from your provider account. Zero means unconfigured.
AI_COST_ENFORCEMENT_ENABLED=false
AI_DAILY_COST_LIMIT_USD=0
AI_MONTHLY_COST_LIMIT_USD=0
AI_BUDGET_RESERVATION_TTL_MINUTES=60
AI_ANTHROPIC_INPUT_USD_PER_MILLION=0
AI_ANTHROPIC_OUTPUT_USD_PER_MILLION=0
# Optional model-specific overrides, for example:
# AI_MODEL_PRICING_JSON={"claude-model-name":{"input_usd_per_million":"...","output_usd_per_million":"..."}}
AI_MODEL_PRICING_JSON=


# --- Daily venue discovery (optional; the rest of the app works without it) ---
# Searches the public web daily for journals, book publishers and conferences,
# verifies them against their official author pages, and stages them in
# Admin > Venue Discovery. Nothing reaches authors until an admin clicks
# "Add to Venue Agent". Only public venue pages are sent to the search API/AI.
VENUE_DISCOVERY_ENABLED=false
# claude_agent (default): Claude is the agent. It decides what to search for and which
# pages to open using Anthropic's web_search and web_fetch tools. Needs only
# ANTHROPIC_API_KEY. Web search is billed by Anthropic (about $10 per 1,000 searches)
# plus tokens; calls are recorded in AI usage and respect the AI cost limits.
VENUE_DISCOVERY_MODE=claude_agent
VENUE_DISCOVERY_MODEL=claude-sonnet-5-5
VENUE_DISCOVERY_CATEGORIES=journal,publisher,conference
VENUE_DISCOVERY_FOCUS=business and management, information systems, supply chain and operations, AI in organizations, and education or simulation-based learning
VENUE_DISCOVERY_VENUES_PER_CATEGORY=6
VENUE_DISCOVERY_MAX_SEARCHES_PER_REQUEST=8
VENUE_DISCOVERY_MAX_FETCHES_PER_REQUEST=12
VENUE_DISCOVERY_FETCH_MAX_CONTENT_TOKENS=6000
VENUE_DISCOVERY_MAX_OUTPUT_TOKENS=8000
VENUE_DISCOVERY_MAX_CONTINUATIONS=4
VENUE_DISCOVERY_RECHECK_BATCH_SIZE=5
VENUE_DISCOVERY_AGENT_TIMEOUT_SECONDS=600
# search_api mode: search sources + this server's own safe page fetcher; the AI only reads pages.
# Free setup (no API keys, no per-use bill):
#   VENUE_DISCOVERY_MODE=search_api
#   VENUE_SEARCH_PROVIDER=searxng,doaj
#   VENUE_SEARXNG_URL=http://127.0.0.1:8888
#   VENUE_DISCOVERY_AI_PROVIDER=ollama
#   VENUE_DISCOVERY_OLLAMA_MODEL=qwen2.5:7b-instruct   (0.5b works for testing only)
# VENUE_SEARCH_PROVIDER accepts any comma-separated mix of openalex, doaj, searxng and tavily.
#   openalex: free global journal catalogue (most-cited journals first), no key, no Docker
#   doaj:     free open-access journal directory, no key
#   searxng:  your own SearXNG (needs Docker); also finds book publishers and conferences
# Variety per run: at most this many venues per country and per website.
VENUE_DISCOVERY_MAX_PER_COUNTRY=2
VENUE_DISCOVERY_MAX_PER_SITE=1
# Directory sources move to a different results page each day (1..N) so runs do not repeat.
VENUE_DISCOVERY_PAGE_ROTATION=5
# Optional: your email for OpenAlex's faster "polite pool".
VENUE_DISCOVERY_CONTACT_EMAIL=
VENUE_SEARCH_PROVIDER=tavily
VENUE_SEARCH_API_KEY=
VENUE_SEARXNG_URL=
# AI provider for search_api-mode extraction: ollama (local, free) or empty = use AI_PROVIDER.
VENUE_DISCOVERY_AI_PROVIDER=
# Local model used only by discovery (empty = OLLAMA_MODEL). Uses OLLAMA_BASE_URL.
VENUE_DISCOVERY_OLLAMA_MODEL=
VENUE_DISCOVERY_OLLAMA_NUM_CTX=8192
VENUE_DISCOVERY_OLLAMA_NUM_PREDICT=1200
VENUE_DISCOVERY_OLLAMA_TIMEOUT_SECONDS=300
VENUE_DISCOVERY_MAX_QUERIES_PER_RUN=16
VENUE_DISCOVERY_MAX_RESULTS_PER_QUERY=10
VENUE_DISCOVERY_MAX_CANDIDATES_PER_RUN=40
VENUE_DISCOVERY_MAX_PAGES_PER_RUN=100
VENUE_DISCOVERY_MAX_PAGES_PER_CANDIDATE=5
# Of those pages, how many may be special-issue / call-for-papers pages (deadlines are read from them).
VENUE_DISCOVERY_MAX_CFP_PAGES=2
# Keep catalogue journals whose own site blocks automated reading, as unverified "unclear"
# venues. Off by default: only venues verified on their official site are staged.
VENUE_DISCOVERY_KEEP_BLOCKED=false
# A run stops taking new venues after this many minutes (must stay below the worker's
# 30-minute job timeout, otherwise the worker kills and re-queues the run).
VENUE_DISCOVERY_MAX_RUN_MINUTES=25
# Default time zone for the daily schedule on the admin page (default Asia/Kolkata, India).
VENUE_DISCOVERY_TIMEZONE=Asia/Kolkata
# Thinking models (Qwen3, DeepSeek-R1) skip their reasoning step during discovery (faster).
VENUE_DISCOVERY_OLLAMA_THINK=false
# Temporary failures (address lookup, HTTP 429/5xx, timeouts) are retried once after this pause.
VENUE_DISCOVERY_RETRY_DELAY_SECONDS=3
VENUE_DISCOVERY_MAX_RECHECKS_PER_RUN=25
VENUE_DISCOVERY_RECHECK_AFTER_HOURS=20
VENUE_DISCOVERY_HTTP_TIMEOUT_SECONDS=15
VENUE_DISCOVERY_PAGE_MAX_BYTES=2000000
VENUE_DISCOVERY_MAX_TEXT_CHARS_PER_PAGE=12000
VENUE_DISCOVERY_MAX_AI_CHARS=30000
VENUE_DISCOVERY_MAX_REDIRECTS=4
VENUE_DISCOVERY_PER_DOMAIN_DELAY_SECONDS=1.0
VENUE_DISCOVERY_USER_AGENT=FlexeeVenueDiscovery/1.0 (+https://www.flexee.org)
# Schedule (run once per environment; idempotent):
#   python manage.py ensure_venue_discovery_schedule --hour 2
# qcluster must be running for scheduled and "Run discovery now" runs.

# Thinking models (Qwen3, DeepSeek-R1) skip their reasoning step for readiness, matching and
# assessment unless this is true (much faster). Models without the option are unaffected.
OLLAMA_THINK=false
