# Flexee Manuscript production environment template
# Copy to .env on the production server and replace every CHANGE_ME value.
# Never commit the real production .env.

DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=manuscript.example.com
FRONTEND_ORIGINS=https://manuscript.example.com
COOKIE_SECURE=true

# TLS terminates at the trusted local Nginx reverse proxy.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
TRUST_X_FORWARDED_PROTO=true
TRUSTED_PROXIES=127.0.0.1

# PostgreSQL production database. Production requires TLS-capable PostgreSQL.
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_DB_HOST:5432/CHANGE_ME_DB

# Private files must live outside the application source tree.
PRIVATE_MEDIA_ROOT=/var/lib/flexee-private-media
MAX_MANUSCRIPT_BYTES=20971520
MAX_SUBMISSION_ITEM_BYTES=10485760
AUTHOR_STORAGE_LIMIT_BYTES=104857600
TOTAL_STORAGE_LIMIT_BYTES=10737418240

# Real SMTP delivery
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false
NOTIFY_FROM_EMAIL=editor@example.com
EDITOR_EMAIL=editor@example.com
DEFAULT_REVIEW_EMAIL=

# Database-backed admin/editor authentication.
# Create the first platform admin with:
# python manage.py create_editor_user admin@example.com --platform_superuser
ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_MAX_FAILURES=10

# Production AI provider
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_KEY
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MOCK_AI_REVIEW=false

# Mandatory cloud cost ceilings and pricing. Replace the zero values with positive deployment-approved limits/current rates.
AI_COST_ENFORCEMENT_ENABLED=true
AI_DAILY_COST_LIMIT_USD=0
AI_MONTHLY_COST_LIMIT_USD=0
AI_BUDGET_RESERVATION_TTL_MINUTES=60
AI_ANTHROPIC_INPUT_USD_PER_MILLION=0
AI_ANTHROPIC_OUTPUT_USD_PER_MILLION=0
AI_MODEL_PRICING_JSON=

# Backups
BACKUP_ROOT=/var/backups/flexee
BACKUP_RETENTION_DAYS=30
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
RESTORE_TARGET_DATABASE_URL=
RELEASE_SHA=CHANGE_ME_DEPLOYED_GIT_SHA

# Sentry
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=CHANGE_ME_DEPLOYED_GIT_SHA
SENTRY_TRACES_SAMPLE_RATE=0

# Queue health
REVIEW_JOB_QUEUE_TIMEOUT_MINUTES=10
REVIEW_JOB_PROCESSING_TIMEOUT_MINUTES=30
QUEUE_HEALTH_WARNING_QUEUED_JOBS=10
QUEUE_HEALTH_CRITICAL_QUEUED_JOBS=25
QUEUE_HEALTH_WARNING_OLDEST_QUEUED_SECONDS=300
QUEUE_HEALTH_CRITICAL_OLDEST_QUEUED_SECONDS=600
QUEUE_HEALTH_WARNING_OLDEST_PROCESSING_SECONDS=1350
QUEUE_HEALTH_CRITICAL_OLDEST_PROCESSING_SECONDS=1800
QUEUE_HEALTH_FAILURE_WINDOW_MINUTES=60
QUEUE_HEALTH_WARNING_RECENT_FAILURES=3
QUEUE_HEALTH_CRITICAL_RECENT_FAILURES=10
QUEUE_HEALTH_ALERT_COOLDOWN_MINUTES=30

# Retention / verification
RETENTION_SWEEP_BATCH_SIZE=200
AUTHOR_VERIFY_RESEND_WINDOW_MINUTES=15
AUTHOR_VERIFY_RESEND_MAX=3

# ZIP hardening
MANUSCRIPT_ZIP_MAX_FILES=40
MANUSCRIPT_ZIP_MAX_UNCOMPRESSED_BYTES=52428800
MANUSCRIPT_ZIP_MAX_COMPRESSION_RATIO=200
